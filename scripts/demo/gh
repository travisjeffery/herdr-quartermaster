#!/usr/bin/env python3
"""A stand-in `gh` for the demo recording: answers the calls quartermaster's
ticker makes from $QM_DEMO/world.json, so PR state is whatever the demo
script says it is. Nothing reaches GitHub.

world.json is {"login": "...", "prs": [PR, ...]}, each PR in `gh pr view
--json` shape.
"""
import json
import os
import re
import sys

LIST = ["number", "title", "url", "headRefName", "state", "isDraft", "mergedAt"]


def world():
    with open(os.path.join(os.environ["QM_DEMO"], "world.json")) as f:
        return json.load(f)


def pick(pr, fields):
    return {k: pr.get(k) for k in fields}


def main(args):
    w = world()
    prs = w["prs"]
    if args[:2] == ["api", "user"]:
        print(w["login"])
    elif args[:2] == ["pr", "list"]:
        print(json.dumps([pick(p, LIST) for p in prs]))
    elif args[:2] == ["pr", "view"]:
        pr = next((p for p in prs if p["url"] == args[2]), None)
        if pr is None:
            sys.exit("no pull requests found")
        fields = args[args.index("--json") + 1].split(",")
        print(json.dumps(pick(pr, fields)))
    elif args[:1] == ["api"] and "graphql" in args:
        query = next(a for a in args if a.startswith("query="))
        data = {}
        for alias, num in re.findall(r"(p\d+): repository\([^)]*\) \{ pullRequest\(number: (\d+)\)", query):
            pr = next((p for p in prs if p["number"] == int(num)), None)
            if pr is None:
                data[alias] = None
            elif "reviewThreads" in query:
                data[alias] = {"pullRequest": {"headRefOid": pr["headRefOid"],
                                               "reviewThreads": {"pageInfo": {"hasNextPage": False}, "nodes": []}}}
            else:
                data[alias] = {"pullRequest": pick(pr, LIST)}
        print(json.dumps({"data": data}))
    elif args[:1] == ["api"]:
        # Review authors (bot detection) and anything else: nothing.
        pass
    else:
        sys.exit("demo gh: unsupported: " + " ".join(args))


if __name__ == "__main__":
    main(sys.argv[1:])
